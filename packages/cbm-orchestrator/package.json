{
  "name": "@cbm/orchestrator",
  "version": "0.1.0",
  "description": "CBM System Intelligence Engine Orchestrator",
  "type": "module",
  "bin": {
    "cbm": "./src/cli.ts"
  },
  "scripts": {
    "build": "node --check src/cli.ts",
    "deploy:local": "powershell -ExecutionPolicy Bypass -File ../../scripts/deploy-local.ps1",
    "test": "node --test --test-concurrency=1 --test-timeout=20000 test/**/*.test.ts",
    "test:live-mcp": "node --test integration/real-mcp.test.ts",
    "start": "node src/cli.ts serve",
    "interactive": "node src/cli.ts interactive",
    "probe": "node src/cli.ts probe",
    "cycle": "node src/cli.ts run",
    "spike": "node src/cli.ts spike"
  },
  "engines": { "node": ">=24" }
}
